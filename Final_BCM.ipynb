    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "import torch.optim as optim\n",
        "import torchaudio\n",
        "import gc\n",
        "import os\n",
        "import glob\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "\n",
        "# Ensure environment is clean\n",
        "gc.collect()\n",
        "torch.cuda.empty_cache()\n",
        "\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "scaler = torch.amp.GradScaler('cuda') if device.type == 'cuda' else None\n",
        "\n",
        "# Define BCADataset class\n",
        "class BCADataset(Dataset):\n",
        "    def __init__(self, bc_data_dir, ac_data_dir, segment_len=16384):\n",
        "        self.segment_len = segment_len\n",
        "        self.bc_files = sorted(glob.glob(os.path.join(bc_data_dir, \"*.wav\")))\n",
        "        self.ac_files = sorted(glob.glob(os.path.join(ac_data_dir, \"*.wav\")))\n",
        "\n",
        "        assert len(self.bc_files) == len(self.ac_files), \"Number of BC and AC files must match!\"\n",
        "\n",
        "    def __len__(self): return len(self.bc_files)\n",
        "    def __getitem__(self, idx):\n",
        "        bc, sr_bc = torchaudio.load(self.bc_files[idx])\n",
        "        ac, sr_ac = torchaudio.load(self.ac_files[idx])\n",
        "\n",
        "        assert sr_bc == sr_ac, f\"Sampling rates mismatch for {self.bc_files[idx]} and {self.ac_files[idx]}\"\n",
        "\n",
        "        if bc.shape[-1] > self.segment_len:\n",
        "            bc = bc[:, :self.segment_len]\n",
        "            ac = ac[:, :self.segment_len]\n",
        "        else:\n",
        "            p = self.segment_len - bc.shape[-1]\n",
        "            bc, ac = F.pad(bc, (0, p)), F.pad(ac, (0, p))\n",
        "\n",
        "        # For this magnitude-based model, we need magnitude and phase, and original waves\n",
        "        # Compute STFT for magnitude and phase\n",
        "        # Assuming n_fft=512, hop_length=128 for consistency with ISTFT later\n",
        "        n_fft, hop_length, win_length = 512, 128, 512\n",
        "        window = torch.hann_window(win_length).to(device)\n",
        "\n",
        "        # Move bc and ac to the same device as the window before STFT\n",
        "        bc = bc.to(device)\n",
        "        ac = ac.to(device)\n",
        "\n",
        "        bc_stft = torch.stft(bc.squeeze(0), n_fft=n_fft, hop_length=hop_length, win_length=win_length, window=window, return_complex=True)\n",
        "        air_stft = torch.stft(ac.squeeze(0), n_fft=n_fft, hop_length=hop_length, win_length=win_length, window=window, return_complex=True)\n",
        "\n",
        "        bc_mag = bc_stft.abs().unsqueeze(0) # Add channel dimension\n",
        "        bc_phase = bc_stft.angle().unsqueeze(0) # Add channel dimension\n",
        "        air_mag = air_stft.abs().unsqueeze(0) # Add channel dimension\n",
        "\n",
        "        # Squeeze the channel dimension from the raw waveforms before returning\n",
        "        # This makes the DataLoader yield [batch_size, samples] for bc_wave and air_wave\n",
        "        return bc_mag, bc_phase, air_mag, bc.squeeze(0), ac.squeeze(0)\n",
        "\n",
        "\n",
        "# Initialize Models with Residual Architecture\n",
        "G, D = Generator().to(device), Discriminator().to(device)\n",
        "optG = optim.Adam(G.parameters(), lr=1e-4, betas=(0.5, 0.9))\n",
        "optD = optim.Adam(D.parameters(), lr=1e-4, betas=(0.5, 0.9))\n",
        "mrstft = MultiResolutionSTFTLoss().to(device)\n",
        "\n",
        "# Initialize Dataset and DataLoader\n",
        "bc_train_path = \"/content/drive/MyDrive/DATA/BCM/train/actual\"\n",
        "ac_train_path = \"/content/drive/MyDrive/DATA/BCM/train/reference\"\n",
        "dataset = BCADataset(bc_train_path, ac_train_path) # Pass the training data directory\n",
        "loader = DataLoader(dataset, batch_size=4, shuffle=True)\n",
        "\n",
        "history = {'l1': [], 'stft': [], 'adv': [], 'g_total': []}\n",
        "\n",
        "print(f'Training Residual Generator on {device}...')\n",
        "\n",
        "for epoch in range(30):\n",
        "    for i, (bc_mag, bc_phase, air_mag, bc_wave, air_wave) in enumerate(loader):\n",
        "        bc_mag, air_mag = bc_mag.to(device), air_mag.to(device)\n",
        "        # bc_wave and air_wave are now [batch_size, samples] after BCADataset change\n",
        "        bc_wave, air_wave = bc_wave.to(device), air_wave.to(device)\n",
        "        bc_phase = bc_phase.to(device)\n",
        "\n",
        "        # --- Train Discriminator ---\n",
        "        optD.zero_grad()\n",
        "        with torch.amp.autocast(device_type=device.type, enabled=(device.type=='cuda')):\n",
        "            fake_mag = G(bc_mag)\n",
        "            r_log, _ = D(bc_mag, air_mag)\n",
        "            f_log, _ = D(bc_mag, fake_mag.detach())\n",
        "            d_loss = discriminator_loss(r_log, f_log)\n",
        "\n",
        "        if scaler: scaler.scale(d_loss).backward(); scaler.step(optD)\n",
        "        else: d_loss.backward(); optD.step()\n",
        "\n",
        "        # --- Train Generator ---\n",
        "        optG.zero_grad()\n",
        "        with torch.amp.autocast(device_type=device.type, enabled=(device.type=='cuda')):\n",
        "            f_log, f_f = D(bc_mag, fake_mag)\n",
        "            _, r_f = D(bc_mag, air_mag)\n",
        "\n",
        "            l1 = magnitude_loss(fake_mag, air_mag)\n",
        "            adv = generator_loss(f_log)\n",
        "            fm = feature_matching_loss(f_f, r_f)\n",
        "\n",
        "            # Multi-Resolution STFT Loss\n",
        "            mag_f32 = fake_mag.squeeze(1).float()\n",
        "            phase_f32 = bc_phase.squeeze(1).float()\n",
        "            spec_c = torch.polar(mag_f32, phase_f32)\n",
        "            e_w = torch.istft(spec_c, 512, 128, window=torch.hann_window(512).to(device))\n",
        "\n",
        "            # air_wave is now [batch_size, samples], so no channel squeezing needed here\n",
        "            stft_l = mrstft(e_w, air_wave[:, :e_w.shape[-1]])\n",
        "\n",
        "            g_total = (10.0 * l1) + (5.0 * stft_l) + (0.1 * adv) + (2.0 * fm)\n",
        "\n",
        "        if scaler: scaler.scale(g_total).backward(); scaler.step(optG); scaler.update()\n",
        "        else: g_total.backward(); optG.step()\n",
        "\n",
        "        history['l1'].append(l1.item())\n",
        "        history['stft'].append(stft_l.item())\n",
        "        history['adv'].append(adv.item())\n",
        "        history['g_total'].append(g_total.item())\n",
        "\n",
        "    if epoch % 5 == 0:\n",
        "        print(f'Epoch {epoch} | G Loss: {g_total.item():.4f} | L1: {l1.item():.4f}')"

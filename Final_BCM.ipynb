    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "\n",
        "\n",
        "def feature_matching_loss(fake_features,\n",
        "                          real_features):\n",
        "\n",
        "    loss = 0\n",
        "\n",
        "    for f_fake, f_real in zip(fake_features,\n",
        "                              real_features):\n",
        "\n",
        "        loss += torch.mean(\n",
        "\n",
        "            torch.abs(\n",
        "                f_fake-f_real.detach()\n",
        "            )\n",
        "        )\n",
        "\n",
        "    return loss"
      ],

        "\n",
        "    # Ensure phase matches magnitude shape\n",
        "    if phase_sq.shape != enh_mag_sq.shape:\n",
        "        p_init = F.interpolate(phase_sq.unsqueeze(0).unsqueeze(0), size=enh_mag_sq.shape, mode='nearest').squeeze()\n",
        "    else:\n",
        "        p_init = phase_sq\n",
        "\n",
        "    # ISTFT to get enhanced waveform\n",

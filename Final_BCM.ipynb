      "source": [
        "import os\n",
        "import glob\n",
        "import torchaudio\n",
        "import torch\n",
        "import torch.nn.functional as F\n",
        "\n",
        "# Define paths\n",
        "bc_input_dir = \"/content/drive/MyDrive/DATA/BCM/train/actual\"\n",
        "output_dir = \"/content/drive/MyDrive/DATA/BCM/train/out\"\n",
        "\n",
        "# Create output directory if it doesn't exist\n",
        "os.makedirs(output_dir, exist_ok=True)\n",
        "\n",
        "# Get list of bone conduction files\n",
        "bc_files = sorted(glob.glob(os.path.join(bc_input_dir, \"*.wav\")))\n",
        "\n",
        "if len(bc_files) == 0:\n",
        "    print(f\"No WAV files found in {bc_input_dir}. Please check the path.\")\n",
        "else:\n",
        "    print(f\"Found {len(bc_files)} files to process in {bc_input_dir}.\")\n",
        "\n",
        "# Ensure generator is in evaluation mode and on the correct device\n",
        "generator.eval()\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "generator.to(device)\n",
        "\n",
        "# STFT parameters (should match training parameters)\n",
        "n_fft, hop_length, win_length = 512, 128, 512\n",
        "window = torch.hann_window(win_length).to(device)\n",
        "fs = 16000 # Assuming a fixed sampling rate\n",
        "\n",
        "for i, bc_filepath in enumerate(bc_files):\n",
        "    print(f\"Processing {i+1}/{len(bc_files)}: {os.path.basename(bc_filepath)}\")\n",
        "    try:\n",
        "        # Load bone conduction audio\n",
        "        bc_wave, sr = torchaudio.load(bc_filepath)\n",
        "        if sr != fs:\n",
        "            print(f\"Warning: Sampling rate mismatch for {os.path.basename(bc_filepath)}. Resampling from {sr} to {fs}.\")\n",
        "            resampler = torchaudio.transforms.Resample(orig_freq=sr, new_freq=fs).to(device)\n",
        "            bc_wave = resampler(bc_wave.to(device))\n",
        "        else:\n",
        "            bc_wave = bc_wave.to(device)\n",
        "\n",
        "        # Ensure the waveform has a batch and channel dimension (1, 1, samples) for STFT\n",
        "        if bc_wave.dim() == 1: # Mono audio\n",
        "            bc_wave = bc_wave.unsqueeze(0).unsqueeze(0) # Add batch and channel\n",
        "        elif bc_wave.dim() == 2: # (channels, samples)\n",
        "            bc_wave = bc_wave.unsqueeze(0) # Add batch\n",
        "\n",
        "        # Trim or pad to a consistent length if necessary, or process variable lengths\n",
        "        # For this example, let's assume `segment_len` as in the dataset\n",
        "        segment_len = 16384 # This should match the segment_len used in BCADataset\n",
        "        if bc_wave.shape[-1] > segment_len:\n",
        "            bc_wave_processed = bc_wave[..., :segment_len]\n",
        "        else:\n",
        "            p = segment_len - bc_wave.shape[-1]\n",
        "            bc_wave_processed = F.pad(bc_wave, (0, p))\n",
        "\n",
        "        # Compute STFT for magnitude and phase\n",
        "        bc_stft = torch.stft(bc_wave_processed.squeeze(0), n_fft=n_fft, hop_length=hop_length, win_length=win_length, window=window, return_complex=True)\n",
        "        bc_mag = bc_stft.abs().unsqueeze(0) # Add channel dimension (batch, channel, freq, time)\n",
        "        bc_phase = bc_stft.angle().unsqueeze(0) # Add channel dimension\n",
        "\n",
        "        # Generate enhanced magnitude\n",
        "        with torch.no_grad():\n",
        "            enhanced_mag = generator(bc_mag)\n",
        "\n",
        "        # Reconstruct waveform using enhanced magnitude and original phase\n",
        "        enh_mag_sq = enhanced_mag.squeeze().cpu()\n",
        "        phase_sq = bc_phase.squeeze().cpu()\n",
        "\n",
        "        # Ensure phase matches magnitude shape (interpolation if needed, as in inference cell)\n",
        "        if phase_sq.shape != enh_mag_sq.shape:\n",
        "            p_init = F.interpolate(phase_sq.unsqueeze(0).unsqueeze(0), size=enh_mag_sq.shape, mode='nearest').squeeze()\n",
        "        else:\n",
        "            p_init = phase_sq\n",
        "\n",
        "        spec = torch.polar(enh_mag_sq, p_init)\n",
        "        enhanced_wave = torch.istft(spec, n_fft, hop_length, window=torch.hann_window(win_length).to('cpu'), return_complex=False, length=bc_wave.shape[-1])\n",
        "\n",
        "        # Save the enhanced audio\n",
        "        output_filename = os.path.join(output_dir, os.path.basename(bc_filepath).replace('.wav', '_enhanced.wav'))\n",
        "        torchaudio.save(output_filename, enhanced_wave.unsqueeze(0), fs)\n",
        "        print(f\"  Saved enhanced audio to: {output_filename}\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"  Error processing {os.path.basename(bc_filepath)}: {e}\")\n",
        "\n",
        "print(\"Batch inference complete!\")"
      ],

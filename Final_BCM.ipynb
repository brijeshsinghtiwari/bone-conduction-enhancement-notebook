        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "class Generator(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.inc = ConvBlock(1, 64)\n",
        "        self.down1 = Down(64, 128)\n",
        "        self.down2 = Down(128, 256)\n",
        "        self.down3 = Down(256, 512)\n",
        "        self.down4 = Down(512, 512)\n",
        "        self.up1 = Up(1024, 256)\n",
        "        self.up2 = Up(512, 128)\n",
        "        self.up3 = Up(256, 64)\n",
        "        self.up4 = Up(128, 64)\n",
        "        self.out = nn.Sequential(\n",
        "            nn.Conv2d(64, 1, 1),\n",
        "            nn.Tanh()  # Tanh allows adding or subtracting frequencies\n",
        "        )\n",
        "\n",
        "    def forward(self, bc_mag):\n",
        "        # 1. Normalize input for stable processing\n",
        "        norm_factor = bc_mag.max() + 1e-5\n",
        "        x = bc_mag / norm_factor\n",
        "\n",
        "        # 2. Extract features\n",
        "        x1 = self.inc(x)\n",
        "        x2 = self.down1(x1)\n",
        "        x3 = self.down2(x2)\n",
        "        x4 = self.down3(x3)\n",
        "        x5 = self.down4(x4)\n",
        "        x = self.up1(x5, x4)\n",
        "        x = self.up2(x, x3)\n",
        "        x = self.up3(x, x2)\n",
        "        x = self.up4(x, x1)\n",
        "\n",
        "        # 3. Residual connection: Output = Input + Model_Correction\n",
        "        # Scaling back the delta by the norm_factor\n",
        "        delta = self.out(x) * norm_factor\n",
        "        enhanced = bc_mag + delta\n",
        "        return torch.clamp(enhanced, min=0.0) # Ensure magnitudes remain non-negative"
      ],
      "metadata": {
        "id": "qs0dL0mS_8v3"
      },
      "execution_count": 4,

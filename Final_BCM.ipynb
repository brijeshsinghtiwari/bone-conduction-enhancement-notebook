        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "\n",
        "class MultiResolutionSTFTLoss(nn.Module):\n",
        "\n",
        "    def __init__(self):\n",
        "\n",
        "        super().__init__()\n",
        "\n",
        "        self.resolutions = [\n",
        "\n",
        "            (256,64,256),\n",
        "            (512,128,512),\n",
        "            (1024,256,1024)\n",
        "\n",
        "        ]\n",
        "\n",
        "    def forward(self, pred_wave, target_wave):\n",
        "\n",
        "        total_loss = 0\n",
        "\n",
        "        device = pred_wave.device\n",
        "\n",
        "        for n_fft, hop, win in self.resolutions:\n",
        "\n",
        "            window = torch.hann_window(win).to(device)\n",
        "\n",
        "            pred_spec = torch.stft(\n",
        "                pred_wave.squeeze(1), # Squeeze channel dimension\n",
        "                n_fft=n_fft,\n",
        "                hop_length=hop,\n",
        "                win_length=win,\n",
        "                window=window,\n",
        "                return_complex=True\n",
        "            )\n",
        "\n",
        "            target_spec = torch.stft(\n",
        "                target_wave.squeeze(1), # Squeeze channel dimension\n",
        "                n_fft=n_fft,\n",
        "                hop_length=hop,\n",
        "                win_length=win,\n",
        "                window=window,\n",
        "                return_complex=True\n",
        "            )\n",
        "\n",
        "            pred_mag = pred_spec.abs()\n",
        "            target_mag = target_spec.abs()\n",
        "\n",
        "            total_loss += torch.mean(\n",
        "                torch.abs(pred_mag-target_mag)\n",
        "            )\n",
        "\n",
        "        return total_loss/len(self.resolutions)"
      ],
      "metadata": {
        "id": "qzR0zK89ALw9"
      },
      "execution_count": 7,
      "outputs": []

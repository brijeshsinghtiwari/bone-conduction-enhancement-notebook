        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "class Discriminator(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.layers = nn.ModuleList([\n",
        "            nn.Sequential(nn.Conv2d(2, 64, 4, 2, 1), nn.LeakyReLU(0.2)),\n",
        "            nn.Sequential(nn.Conv2d(64, 128, 4, 2, 1), nn.BatchNorm2d(128), nn.LeakyReLU(0.2)),\n",
        "            nn.Sequential(nn.Conv2d(128, 256, 4, 2, 1), nn.BatchNorm2d(256), nn.LeakyReLU(0.2)),\n",
        "            nn.Sequential(nn.Conv2d(256, 512, 4, 1, 1), nn.BatchNorm2d(512), nn.LeakyReLU(0.2))\n",
        "        ])\n",
        "        self.final_conv = nn.Conv2d(512, 1, 4, 1, 1)\n",
        "\n",
        "    def forward(self, bc_mag, air_mag):\n",
        "        x = torch.cat([bc_mag, air_mag], dim=1)\n",
        "        feats = []\n",
        "        for layer in self.layers:\n",
        "            x = layer(x)\n",
        "            feats.append(x)\n",
        "        logits = self.final_conv(x)\n",
        "        return logits, feats"
      ],
